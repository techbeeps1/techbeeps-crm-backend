{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "chat_backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/chatBackend/(.*)",
      "dest": "/chat_backend/index.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "^/(.*)$",
      "dest": "/server.js"
    }
  ]
}
